/**
 * @brief  A packet arrived while in the ACK receive window.
 *         Copy the payload and transition to MASTER_RX_DONE.
 */
static void OnRxDone(uint8_t *payload, uint16_t size,
                     int16_t rssi, int8_t LoraSnr_FskCfo)
{
    /* USER CODE BEGIN OnRxDone */
#if ((USE_MODEM_LORA == 1) && (USE_MODEM_FSK == 0))
    SnrValue = LoraSnr_FskCfo;
#else
    SnrValue = 0; /* SNR not applicable in FSK mode */
#endif

    RssiValue = rssi;

    memset(BufferRx, 0x00, MAX_APP_BUFFER_SIZE);

    if (size <= (MAX_APP_BUFFER_SIZE - 1U))
    {
        memcpy(BufferRx, payload, size);
        RxBufferSize    = size;
        BufferRx[size]  = '\0'; /* ensure NUL-termination for string ops */
    }
    else
    {
        /* Oversized payload — discard */
        RxBufferSize = 0U;
    }

    State = MASTER_RX_DONE;
    UTIL_SEQ_SetTask((1 << CFG_SEQ_Task_SubGHz_Phy_App_Process),
                     CFG_SEQ_Prio_0);
    /* USER CODE END OnRxDone */
}

/**
 * @brief  Radio TX watchdog expired.
 *         Hardware could not complete the transmission.
 */
static void OnTxTimeout(void)
{
    /* USER CODE BEGIN OnTxTimeout */
    State = MASTER_TX_TIMEOUT;
    UTIL_SEQ_SetTask((1 << CFG_SEQ_Task_SubGHz_Phy_App_Process),
                     CFG_SEQ_Prio_0);
    /* USER CODE END OnTxTimeout */
}

/**
 * @brief  RX window expired without receiving any packet.
 *         ACK was not received in time — declare a miss.
 */
static void OnRxTimeout(void)
{
    /* USER CODE BEGIN OnRxTimeout */
    State = MASTER_RX_TIMEOUT;
    UTIL_SEQ_SetTask((1 << CFG_SEQ_Task_SubGHz_Phy_App_Process),
                     CFG_SEQ_Prio_0);
    /* USER CODE END OnRxTimeout */
}

/**
 * @brief  CRC or demodulation error during the ACK receive window.
 *         Treated the same as a miss.
 */
static void OnRxError(void)
{
    /* USER CODE BEGIN OnRxError */
    State = MASTER_RX_ERROR;
    UTIL_SEQ_SetTask((1 << CFG_SEQ_Task_SubGHz_Phy_App_Process),
                     CFG_SEQ_Prio_0);
    /* USER CODE END OnRxError */
}

