/**
 * @brief  TX finished successfully.
 *         Transition to MASTER_TX_DONE so Master_Process() opens the RX window.
 */
static void OnTxDone(void)
{
    /* USER CODE BEGIN OnTxDone */
    State = MASTER_TX_DONE;
    UTIL_SEQ_SetTask((1 << CFG_SEQ_Task_SubGHz_Phy_App_Process),
                     CFG_SEQ_Prio_0);
    /* USER CODE END OnTxDone */
}

