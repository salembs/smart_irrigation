/**
 * @brief  Master FSM — runs in main-loop context via the sequencer.
 *
 *  ┌─────────────────────────────────────────────────────────────────────┐
 *  │  sendTimer fires  ──▶  SendPacket()  ──▶  Radio.Send()             │
 *  │       │                                        │                    │
 *  │       │                              OnTxDone (ISR)                 │
 *  │       │                                        │                    │
 *  │       │                            MASTER_TX_DONE ──▶ Radio.Rx()   │
 *  │       │                                        │                    │
 *  │       │               ┌────────────────────────┤                    │
 *  │       │     OnRxDone  │          OnRxTimeout   │    OnRxError       │
 *  │       │     (ISR)     │          (ISR)         │    (ISR)           │
 *  │       │               │                        │                    │
 *  │  MASTER_RX_DONE  MASTER_RX_TIMEOUT       MASTER_RX_ERROR           │
 *  │  ACK? ✅ stats   ❌ stats + SD hook       ❌ stats + SD hook        │
 *  │  Radio.Sleep()   Radio.Sleep()            Radio.Sleep()             │
 *  └─────────────────────────────────────────────────────────────────────┘
 */
static void Master_Process(void)
{
    switch (State)
    {
        /* ------------------------------------------------------------------ */
        case MASTER_TX_DONE:
        /* TX succeeded — open the ACK receive window                         */
        /* ------------------------------------------------------------------ */
            APP_LOG(TS_ON, VLEVEL_L,
                    "TX done. Opening ACK window (%u ms)...\r\n",
                    (unsigned long)RX_TIMEOUT_VALUE);

            Radio.Rx(RX_TIMEOUT_VALUE);
            break;

        /* ------------------------------------------------------------------ */
        case MASTER_RX_DONE:
        /* A packet arrived in the ACK window — check if it is a valid ACK    */
        /* ------------------------------------------------------------------ */
            Radio.Sleep();

            if ((RxBufferSize > 0U) &&
                (strncmp((const char *)BufferRx, ACK_MSG, strlen(ACK_MSG)) == 0))
            {
                /* ── Valid ACK ─────────────────────────────────────────── */
                ackCounter++;
                LED_Toggle(LED_RED2);

                APP_LOG(TS_ON, VLEVEL_L,
                        "ACK RECEIVED ✅  [RSSI=%d dBm | SNR=%d dB]\r\n",
                        RssiValue, SnrValue);
            }
            else
            {
                /*
                 * ── Unexpected packet (not an ACK) ──────────────────────
                 * The Slave should only send "ACK", so anything else is
                 * treated as a miss.  Call the SD hook with context.
                 */
                missCounter++;
                APP_LOG(TS_ON, VLEVEL_L,
                        "UNEXPECTED RX (not ACK): \"%s\" — treated as miss\r\n",
                        BufferRx);

                SD_SaveMissedPacket(CurrentMsg, txCounter, RssiValue);
            }

            /* Log cycle statistics */
            APP_LOG(TS_OFF, VLEVEL_L,
                    "--- STATS | Sent: %u | ACKed: %u | Missed: %u ---\r\n",
                    (unsigned long)txCounter,
                    (unsigned long)ackCounter,
                    (unsigned long)missCounter);
            break;

        /* ------------------------------------------------------------------ */
        case MASTER_RX_TIMEOUT:
        /* ACK window expired — Slave did not respond in time                  */
        /* ------------------------------------------------------------------ */
            Radio.Sleep();
            missCounter++;

            APP_LOG(TS_ON, VLEVEL_L,
                    "ACK TIMEOUT ❌  No response for \"%s\"\r\n",
                    CurrentMsg);

            SD_SaveMissedPacket(CurrentMsg, txCounter, RssiValue);

            APP_LOG(TS_OFF, VLEVEL_L,
                    "--- STATS | Sent: %u | ACKed: %u | Missed: %u ---\r\n",
                    (unsigned long)txCounter,
                    (unsigned long)ackCounter,
                    (unsigned long)missCounter);
            break;

        /* ------------------------------------------------------------------ */
        case MASTER_RX_ERROR:
        /* CRC / demodulation error during ACK window — treat as miss          */
        /* ------------------------------------------------------------------ */
            Radio.Sleep();
            missCounter++;

            APP_LOG(TS_ON, VLEVEL_L,
                    "RX ERROR ❌  During ACK window for \"%s\"\r\n",
                    CurrentMsg);

            SD_SaveMissedPacket(CurrentMsg, txCounter, RssiValue);

            APP_LOG(TS_OFF, VLEVEL_L,
                    "--- STATS | Sent: %u | ACKed: %u | Missed: %u ---\r\n",
                    (unsigned long)txCounter,
                    (unsigned long)ackCounter,
                    (unsigned long)missCounter);
            break;

        /* ------------------------------------------------------------------ */
        case MASTER_TX_TIMEOUT:
        /* Radio TX watchdog fired — transmission never completed              */
        /* ------------------------------------------------------------------ */
            Radio.Sleep();
            missCounter++;

            APP_LOG(TS_ON, VLEVEL_L,
                    "TX TIMEOUT ❌  Failed to transmit \"%s\"\r\n",
                    CurrentMsg);

            /*
             * TX timeout means the Slave never received the packet,
             * so there is nothing to ACK — log to SD as a miss.
             */
            SD_SaveMissedPacket(CurrentMsg, txCounter, 0);

            APP_LOG(TS_OFF, VLEVEL_L,
                    "--- STATS | Sent: %u | ACKed: %u | Missed: %u ---\r\n",
                    (unsigned long)txCounter,
                    (unsigned long)ackCounter,
                    (unsigned long)missCounter);
            break;

        /* ------------------------------------------------------------------ */
        case MASTER_INIT:
        default:
        /* ------------------------------------------------------------------ */
            Radio.Sleep();
            break;
    }
}

/**
 * @brief  Build the "MSG_<counter>" string, copy it to BufferTx, and
 *         call Radio.Send().
 *
 * @note   Also saves a copy in CurrentMsg so the ACK-miss path can pass
 *         the original payload string to SD_SaveMissedPacket().
 */
static void SendPacket(void)
{

	//    Sensors logic BEGIN___________________________________________________________________________

	    sensor_rain_state = ReadSensorPB5();
	    sensor_soil_state = ReadSensorPB9();
	    APP_LOG(TS_OFF, VLEVEL_M, "==============================\r\n");
		APP_LOG(TS_OFF, VLEVEL_L,
		            "Sensor Rain PB5: => %s\r\n",
					sensor_rain_state ? "LOW" : "HIGH");
		APP_LOG(TS_OFF, VLEVEL_L,
					"Sensor Soil PB9: => %s\r\n",
					sensor_soil_state ? "LOW" : "HIGH");
		APP_LOG(TS_OFF, VLEVEL_M, "==============================\r\n");

		//    Sensors logic END___________________________________________________________________________


    /* Build the message string */
    int len = snprintf(CurrentMsg, sizeof(CurrentMsg), "MSG_%u | Soil: %d | Rain: %d",
                       (unsigned long)txCounter, sensor_soil_state, sensor_rain_state);

    if (len <= 0 || (uint32_t)len >= sizeof(CurrentMsg))
    {
        /* snprintf error or truncation — should never happen for this format */
        APP_LOG(TS_ON, VLEVEL_L, "SendPacket: message format error\r\n");
        return;
    }



    CurrentMsgLen = (uint8_t)len;

    memset(BufferTx, 0x00, MAX_APP_BUFFER_SIZE);
    memcpy(BufferTx, CurrentMsg, CurrentMsgLen);

    APP_LOG(TS_OFF, VLEVEL_L,
            "\r\n------------------------------\r\n");
    APP_LOG(TS_ON,  VLEVEL_L,
            "TRANSMITTING: \"%s\" [#%u]\r\n",
            CurrentMsg,
            (unsigned long)txCounter);

    Radio.Send(BufferTx, CurrentMsgLen);
}

/**
 * @brief  Periodic timer callback — fires every SEND_PERIOD_MS.
 *
 *         Increments the packet counter and triggers a new transmission.
 *         Runs in timer (interrupt) context — keep it minimal.
 */
static void SendTimerCallback(void *context)
{
    UNUSED(context);
    txCounter++;
    SendPacket();
}

/**
 * @brief  LED heartbeat timer callback.
 *         Toggles LED_RED1 and re-arms the one-shot timer.
 */
static void OnledEvent(void *context)
{
    UNUSED(context);
    LED_Toggle(LED_RED1);
    UTIL_TIMER_Start(&timerLed);
}

