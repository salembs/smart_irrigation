/*!
 * \file      subghz_phy_app.c
 *
 * \brief     MASTER NODE — Clean Master-Slave ACK Architecture
 *
 *            Behaviour:
 *              1. A periodic timer fires every SEND_PERIOD_MS.
 *              2. Master builds "MSG_<counter>", transmits it.
 *              3. On TxDone it opens an ACK receive window (RX_TIMEOUT_VALUE ms).
 *              4a. ACK received  -> update stats, LED flash, sleep until next cycle.
 *              4b. RX timeout / RX error -> update stats, call SD_SaveMissedPacket(),
 *                                          sleep until next cycle.
 *              5. No automatic role-switching, no retry, no PING/PONG strings.
 *
 * \note      SD card integration:
 *              Override the __weak  SD_SaveMissedPacket()  in your own .c file
 *              (e.g. sd_logger.c) to write the missed packet to your SD card.
 *              The stub only prints a log line so the project builds without
 *              an SD driver.
 *
 * \copyright Revised BSD License, see section \ref LICENSE.
 */

