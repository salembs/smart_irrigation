/* Private defines -----------------------------------------------------------*/
/* USER CODE BEGIN PD */

/** Maximum size of a LoRa / FSK payload handled by this application. */
#define MAX_APP_BUFFER_SIZE     255U

#if (PAYLOAD_LEN > MAX_APP_BUFFER_SIZE)
#error PAYLOAD_LEN must be less or equal than MAX_APP_BUFFER_SIZE
#endif

/** How long (ms) the Master waits for an ACK before declaring a miss. */
#define RX_TIMEOUT_VALUE        3000U

/** Radio-level TX watchdog (passed to SetTxConfig). */
#define TX_TIMEOUT_VALUE        3000U

/** How often the Master sends a packet [ms]. */
#define SEND_PERIOD_MS          10000U

/** LED heartbeat blink period [ms]. */
#define LED_PERIOD_MS           200U

/** FSK AFC bandwidth — kept for FSK config block, not used in LoRa mode. */
#define FSK_AFC_BANDWIDTH       83333U

/** Expected ACK string (must match what the Slave sends). */
#define ACK_MSG                 "ACK"

/* USER CODE END PD */

/* Private typedefs ----------------------------------------------------------*/
/* USER CODE BEGIN PTD */

/**
 * @brief  Master FSM states.
 *
 *         Radio ISR callbacks write to State and then post the sequencer
 *         task; Master_Process() reads State in the main-loop context.
 */
typedef enum
{
    MASTER_INIT        = 0, /**< Startup — radio idle, waiting for send timer */
    MASTER_TX_DONE,         /**< TX succeeded — open ACK RX window            */
    MASTER_TX_TIMEOUT,      /**< Radio could not finish TX in time             */
    MASTER_RX_DONE,         /**< A packet arrived in the ACK window            */
    MASTER_RX_TIMEOUT,      /**< No packet before RX_TIMEOUT_VALUE expired     */
    MASTER_RX_ERROR,        /**< CRC / demodulation error in the ACK window    */
} MasterState_t;

/* USER CODE END PTD */

/* Private variables ---------------------------------------------------------*/
/* USER CODE BEGIN PV */

/** Registered radio event callbacks. */
static RadioEvents_t RadioEvents;

/**
 * @brief  Current FSM state.
 * @note   Written from radio ISR context, read from task context.
 *         Declared volatile to prevent optimisation issues.
 */
static volatile MasterState_t State = MASTER_INIT;

/** Application TX buffer. */
static uint8_t BufferTx[MAX_APP_BUFFER_SIZE];

/** Application RX buffer. */
static uint8_t BufferRx[MAX_APP_BUFFER_SIZE];

/** Number of bytes actually received in the last OnRxDone callback. */
static uint16_t RxBufferSize = 0;

/** RSSI of the last received packet [dBm]. */
static int16_t RssiValue = 0;

/** SNR of the last received LoRa packet [dB].  0 for FSK (not applicable). */
static int8_t SnrValue = 0;

/**
 * @brief  Copy of the message string sent in the current cycle.
 *         Kept so it can be passed to SD_SaveMissedPacket() on a miss without
 *         re-building it.
 */
static char CurrentMsg[64];

/** Length of CurrentMsg in bytes (excluding NUL terminator). */
static uint8_t CurrentMsgLen = 0;

/* --- Statistics counters -------------------------------------------------- */
static uint32_t txCounter   = 0; /**< Total packets transmitted since boot.   */
static uint32_t ackCounter  = 0; /**< Total ACKs successfully received.       */
static uint32_t missCounter = 0; /**< Total missed ACKs (timeout + error).    */
uint8_t sensor_rain_state = 1;
uint8_t sensor_soil_state = 1;

/* --- Timer objects --------------------------------------------------------- */
static UTIL_TIMER_Object_t timerLed;  /**< Heartbeat LED blink timer.         */
static UTIL_TIMER_Object_t sendTimer; /**< Periodic transmit trigger timer.   */

/* USER CODE END PV */

/* Private function prototypes -----------------------------------------------*/
static void OnTxDone(void);
static void OnRxDone(uint8_t *payload, uint16_t size,
                     int16_t rssi, int8_t LoraSnr_FskCfo);
static void OnTxTimeout(void);
static void OnRxTimeout(void);
static void OnRxError(void);

/* USER CODE BEGIN PFP */
static void Master_Process(void);
static void SendPacket(void);
static void SendTimerCallback(void *context);
static void OnledEvent(void *context);
/* USER CODE END PFP */

/* ── SD card hook (weak — override in your sd_logger.c) ─────────────────── */
/**
 * @brief  Called every time an ACK is NOT received (timeout or RX error).
 *
 * @param  msg       Null-terminated payload string of the missed packet
 *                   (e.g. "MSG_7").
 * @param  counter   Sequence number of the missed packet (== txCounter).
 * @param  lastRssi  Last RSSI value known to the Master [dBm].
 *                   Will be 0 if no packet at all was received this cycle.
 *
 * @note   The default implementation only prints a log line.
 *         Provide your own non-weak version in a separate .c file to write
 *         to the SD card (e.g. via FatFs or your BSP SD driver).
 *
 * Example override in sd_logger.c:
 * @code
 *   void SD_SaveMissedPacket(const char *msg, uint32_t counter, int16_t lastRssi)
 *   {
 *       char line[128];
 *       snprintf(line, sizeof(line), "%lu,%s,%d\n", counter, msg, lastRssi);
 *       SD_WriteToLog(line);   // your FatFs write call
 *   }
 * @endcode
 */
__weak void SD_SaveMissedPacket(const char *msg,
                                uint32_t    counter,
                                int16_t     lastRssi);

