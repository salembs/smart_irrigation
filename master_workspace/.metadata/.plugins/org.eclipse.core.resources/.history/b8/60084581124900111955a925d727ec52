void SubghzApp_Init(void)
{
    /* USER CODE BEGIN SubghzApp_Init_1 */
    APP_LOG(TS_OFF, VLEVEL_M, "\r\n==============================\r\n");
    APP_LOG(TS_OFF, VLEVEL_M, "        MASTER NODE\r\n");
    APP_LOG(TS_OFF, VLEVEL_M, "==============================\r\n");
    APP_LOG(TS_OFF, VLEVEL_M, "APP_VERSION= V%X.%X.%X\r\n",
            (uint8_t)(__APP_VERSION >> __APP_VERSION_MAIN_SHIFT),
            (uint8_t)(__APP_VERSION >> __APP_VERSION_SUB1_SHIFT),
            (uint8_t)(__APP_VERSION >> __APP_VERSION_SUB2_SHIFT));

    /* ── LEDs ───────────────────────────────────────────────────────────── */
    LED_Init(LED_RED1);   /* Heartbeat blink                                  */
    LED_Init(LED_RED2);   /* Flashes on successful ACK                        */

    UTIL_TIMER_Create(&timerLed, 0xFFFFFFFFU, UTIL_TIMER_ONESHOT,
                      OnledEvent, NULL);
    UTIL_TIMER_SetPeriod(&timerLed, LED_PERIOD_MS);
    UTIL_TIMER_Start(&timerLed);
    /* USER CODE END SubghzApp_Init_1 */

    /* ── Radio initialisation ───────────────────────────────────────────── */
    RadioEvents.TxDone    = OnTxDone;
    RadioEvents.RxDone    = OnRxDone;
    RadioEvents.TxTimeout = OnTxTimeout;
    RadioEvents.RxTimeout = OnRxTimeout;
    RadioEvents.RxError   = OnRxError;

    Radio.Init(&RadioEvents);

    /* USER CODE BEGIN SubghzApp_Init_2 */
    Radio.SetChannel(RF_FREQUENCY);

#if ((USE_MODEM_LORA == 1) && (USE_MODEM_FSK == 0))
    APP_LOG(TS_OFF, VLEVEL_M, "Modulation : LoRa\r\n");
    APP_LOG(TS_OFF, VLEVEL_M, "Frequency  : %u Hz\r\n",
            (unsigned long)RF_FREQUENCY);
    APP_LOG(TS_OFF, VLEVEL_M, "BW         : %d kHz\r\n",
            (1 << LORA_BANDWIDTH) * 125);
    APP_LOG(TS_OFF, VLEVEL_M, "SF         : %d\r\n", LORA_SPREADING_FACTOR);
    APP_LOG(TS_OFF, VLEVEL_M, "CR         : 4/%d\r\n",
            LORA_CODINGRATE + 4);
    APP_LOG(TS_OFF, VLEVEL_M, "TX Power   : %d dBm\r\n", TX_OUTPUT_POWER);

    Radio.SetTxConfig(MODEM_LORA,
                      TX_OUTPUT_POWER, 0,
                      LORA_BANDWIDTH,
                      LORA_SPREADING_FACTOR, LORA_CODINGRATE,
                      LORA_PREAMBLE_LENGTH, LORA_FIX_LENGTH_PAYLOAD_ON,
                      true,               /* CRC on */
                      0, 0,               /* freq-hop off */
                      LORA_IQ_INVERSION_ON,
                      TX_TIMEOUT_VALUE);

    Radio.SetRxConfig(MODEM_LORA,
                      LORA_BANDWIDTH,
                      LORA_SPREADING_FACTOR, LORA_CODINGRATE,
                      0,                  /* AFC BW (LoRa: unused) */
                      LORA_PREAMBLE_LENGTH,
                      LORA_SYMBOL_TIMEOUT,
                      LORA_FIX_LENGTH_PAYLOAD_ON,
                      0,                  /* payload len (variable) */
                      true,               /* CRC on */
                      0, 0,               /* freq-hop off */
                      LORA_IQ_INVERSION_ON,
                      true);              /* continuous RX (overridden by timeout) */

    Radio.SetMaxPayloadLength(MODEM_LORA, MAX_APP_BUFFER_SIZE);

#elif ((USE_MODEM_LORA == 0) && (USE_MODEM_FSK == 1))
    APP_LOG(TS_OFF, VLEVEL_M, "Modulation : FSK\r\n");
    APP_LOG(TS_OFF, VLEVEL_M, "BW         : %d Hz\r\n", FSK_BANDWIDTH);
    APP_LOG(TS_OFF, VLEVEL_M, "DR         : %d bps\r\n", FSK_DATARATE);

    Radio.SetTxConfig(MODEM_FSK,
                      TX_OUTPUT_POWER, FSK_FDEV, 0,
                      FSK_DATARATE, 0,
                      FSK_PREAMBLE_LENGTH, FSK_FIX_LENGTH_PAYLOAD_ON,
                      true, 0, 0, 0,
                      TX_TIMEOUT_VALUE);

    Radio.SetRxConfig(MODEM_FSK,
                      FSK_BANDWIDTH, FSK_DATARATE,
                      0, FSK_AFC_BANDWIDTH, FSK_PREAMBLE_LENGTH,
                      0, FSK_FIX_LENGTH_PAYLOAD_ON,
                      0, true, 0, 0, false, true);

    Radio.SetMaxPayloadLength(MODEM_FSK, MAX_APP_BUFFER_SIZE);

#else
#error "Please define a modulation in subghz_phy_app.h (USE_MODEM_LORA or USE_MODEM_FSK)."
#endif /* USE_MODEM_LORA | USE_MODEM_FSK */

    /* ── Buffer initialisation ──────────────────────────────────────────── */
    memset(BufferTx,    0x00, MAX_APP_BUFFER_SIZE);
    memset(BufferRx,    0x00, MAX_APP_BUFFER_SIZE);
    memset(CurrentMsg,  0x00, sizeof(CurrentMsg));

    /* ── Sequencer task registration ────────────────────────────────────── */
    UTIL_SEQ_RegTask((1 << CFG_SEQ_Task_SubGHz_Phy_App_Process),
                     UTIL_SEQ_RFU,
                     Master_Process);

    /* ── Periodic send timer ────────────────────────────────────────────── */
    UTIL_TIMER_Create(&sendTimer, 0xFFFFFFFFU, UTIL_TIMER_PERIODIC,
                      SendTimerCallback, NULL);
    UTIL_TIMER_SetPeriod(&sendTimer, SEND_PERIOD_MS);
    UTIL_TIMER_Start(&sendTimer);

    APP_LOG(TS_OFF, VLEVEL_M, "Send interval : %u ms\r\n",
            (unsigned long)SEND_PERIOD_MS);
    APP_LOG(TS_OFF, VLEVEL_M, "ACK timeout   : %u ms\r\n",
            (unsigned long)RX_TIMEOUT_VALUE);
    APP_LOG(TS_OFF, VLEVEL_M, "==============================\r\n");
    APP_LOG(TS_OFF, VLEVEL_M, "Waiting for first send timer...\r\n");

    /* Radio idles in sleep until the first send timer fires */
    Radio.Sleep();
    /* USER CODE END SubghzApp_Init_2 */
}

