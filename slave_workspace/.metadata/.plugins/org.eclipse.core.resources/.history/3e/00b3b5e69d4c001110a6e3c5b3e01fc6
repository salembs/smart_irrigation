 * Private functions
 * ========================================================================= */

/* USER CODE BEGIN PrFD */

static void Slave_Process(void)
{
	switch (State)
	    {
	        /* ------------------------------------------------------------------ */
	        case SLAVE_RX_DONE:
	        /* Packet received — log it, then fire the ACK immediately            */
	        /* ------------------------------------------------------------------ */
	            rxCounter++;
	            LED_Toggle(LED_RED2);

	            APP_LOG(TS_OFF, VLEVEL_L,
	                    "\r\n------------------------------\r\n");
	            APP_LOG(TS_ON,  VLEVEL_L,
	                    "RX [#%u]: \"%s\" | RSSI=%d dBm | SNR=%d dB\r\n",
	                    (unsigned long)rxCounter,
	                    (RxBufferSize > 0U) ? (const char *)BufferRx : "<empty>",
	                    RssiValue,
	                    SnrValue);


	            /* ── Forward received LoRa payload to ESP32 ─────────────────── */
				if (RxBufferSize > 0U)                        /* ← ADD THIS BLOCK */
				{
					char uartBuf[MAX_APP_BUFFER_SIZE + 32];
					int  uartLen = snprintf(uartBuf, sizeof(uartBuf),
											"LORA:RX:%s:RSSI=%d:SNR=%d\r\n",
											(char *)BufferRx,
											RssiValue,
											SnrValue);

					if (uartLen > 0)
					{
			            APP_LOG(TS_OFF, VLEVEL_H,"Received: %s ", uartBuf);
						ESP32_UART_SendString(uartBuf);
					}
				}
				/* ── End ESP32 forward ──────────────────────────────────────── */
	            APP_LOG(TS_ON,  VLEVEL_L, "Sending ACK...\r\n");

	            /*
	             * BufferTx is pre-loaded with "ACK" in SubghzApp_Init().
	             * No memcpy needed here — just call Send directly.
	             */
	            Radio.Send(BufferTx, ACK_MSG_LEN);
	            break;

	        /* ------------------------------------------------------------------ */
	        case SLAVE_TX_DONE:
	        /* ACK sent successfully — log stats and return to continuous RX      */
	        /* ------------------------------------------------------------------ */
	            ackSentCounter++;

	            APP_LOG(TS_ON, VLEVEL_L,
	                    "ACK sent ✅  [#%u]\r\n",
	                    (unsigned long)ackSentCounter);
	            APP_LOG(TS_OFF, VLEVEL_L,
	                    "--- STATS | RX: %u | ACK Sent: %u | Errors: %u ---\r\n",
	                    (unsigned long)rxCounter,
	                    (unsigned long)ackSentCounter,
	                    (unsigned long)errorCounter);

	            // ESP32_UART_SendString("ACK_SENT\r\n");        /* ← ADD THIS */

	            Radio.Rx(0); /* back to continuous RX */
	            break;

	        /* ------------------------------------------------------------------ */
	        case SLAVE_TX_TIMEOUT:
	        /* ACK TX watchdog fired — recover by returning to RX                 */
	        /* ------------------------------------------------------------------ */
	            errorCounter++;

	            APP_LOG(TS_ON, VLEVEL_L,
	                    "ACK TX TIMEOUT ❌  [error #%u] — returning to RX\r\n",
	                    (unsigned long)errorCounter);

	            Radio.Rx(0);
	            break;

	        /* ------------------------------------------------------------------ */
	        case SLAVE_RX_ERROR:
	        /* CRC / demodulation error — return to RX; Master will retry         */
	        /* ------------------------------------------------------------------ */
	            errorCounter++;

	            APP_LOG(TS_ON, VLEVEL_L,
	                    "RX ERROR ❌  [error #%u] — returning to RX\r\n",
	                    (unsigned long)errorCounter);

	            Radio.Rx(0);
	            break;

	        /* ------------------------------------------------------------------ */
	        case SLAVE_RX_TIMEOUT:
	        /* Should never occur with continuous RX — handled defensively        */
	        /* ------------------------------------------------------------------ */
	            APP_LOG(TS_ON, VLEVEL_L,
	                    "RX TIMEOUT (unexpected) — returning to RX\r\n");

	            Radio.Rx(0);
	            break;

	        /* ------------------------------------------------------------------ */
	        case SLAVE_IDLE:
	        default:
	        /* ------------------------------------------------------------------ */
	            /* Nothing to do — radio is already in RX */
	            break;
	    }


}

static void ESP32_Cmd_Process(void)
{
    char cmd[ESP32_CMD_MAX_LEN];

    while (ESP32_UART_GetCommand(cmd, sizeof(cmd)))
    {
        APP_LOG(TS_ON, VLEVEL_L, "ESP32 CMD: \"%s\"\r\n", cmd);

        if (strncmp(cmd, "TON", 3) == 0)
        {
            HAL_GPIO_WritePin(GPIOB, GPIO_PIN_8, GPIO_PIN_RESET);
            ESP32_UART_SendString("PUMP:ON\r\n");
            APP_LOG(TS_ON, VLEVEL_L, "Pump ON\r\n");
        }
        else if (strncmp(cmd, "TOF", 3) == 0)
        {
            HAL_GPIO_WritePin(GPIOB, GPIO_PIN_8, GPIO_PIN_SET);
            ESP32_UART_SendString("PUMP:OFF\r\n");
            APP_LOG(TS_ON, VLEVEL_L, "Pump OFF\r\n");
        }
        else
        {
            ESP32_UART_SendString("UNKNOWN_CMD\r\n");
        }
    }
}

/**
 * @brief  LED heartbeat timer callback.
 *         Toggles LED_RED1 and re-arms the one-shot timer.
 */
static void OnledEvent(void *context)
{
    UNUSED(context);
    LED_Toggle(LED_RED1);
    UTIL_TIMER_Start(&timerLed);
}

