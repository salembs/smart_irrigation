/** Maximum LoRa / FSK payload size handled by this application. */
#define MAX_APP_BUFFER_SIZE     255U

#if (PAYLOAD_LEN > MAX_APP_BUFFER_SIZE)
#error PAYLOAD_LEN must be less or equal than MAX_APP_BUFFER_SIZE
#endif

/** Radio-level TX watchdog [ms] (passed to SetTxConfig). */
#define TX_TIMEOUT_VALUE        3000U

/**
 * @brief  ACK string transmitted back to the Master.
 * @note   Must match the ACK_MSG defined in the Master's subghz_phy_app.c.
 */
#define ACK_MSG                 "ACK"
#define ACK_MSG_LEN             3U  /* strlen("ACK") — avoid runtime call */

/** LED heartbeat blink period [ms].
 *  Slower than the Master (500 ms) to visually distinguish the two nodes. */
#define LED_PERIOD_MS           500U

/** FSK AFC bandwidth — kept for FSK config block, not used in LoRa mode. */
#define FSK_AFC_BANDWIDTH       83333U

/* USER CODE END PD */

