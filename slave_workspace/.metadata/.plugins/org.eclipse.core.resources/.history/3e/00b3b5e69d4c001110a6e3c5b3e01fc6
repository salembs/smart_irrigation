/**
 * @brief  Slave FSM states.
 *
 *         Radio ISR callbacks write to State and post the sequencer task;
 *         Slave_Process() reads State in the main-loop context.
 */
typedef enum
{
    SLAVE_IDLE       = 0, /**< Idle in continuous RX — waiting for Master     */
    SLAVE_RX_DONE,        /**< Packet received — must send ACK immediately    */
    SLAVE_RX_TIMEOUT,     /**< RX timeout (should not occur in continuous RX) */
    SLAVE_RX_ERROR,       /**< CRC / demodulation error — return to RX        */
    SLAVE_TX_DONE,        /**< ACK sent successfully — return to RX           */
    SLAVE_TX_TIMEOUT,     /**< ACK TX watchdog fired — return to RX           */
} SlaveState_t;

/* USER CODE END PTD */

/* Private variables ---------------------------------------------------------*/
/* USER CODE BEGIN PV */

/** Registered radio event callbacks. */
static RadioEvents_t RadioEvents;

/**
 * @brief  Current FSM state.
 * @note   Written from radio ISR context, read from task context.
 */
static volatile SlaveState_t State = SLAVE_IDLE;

/** Application TX buffer — pre-loaded with "ACK" once at init. */
static uint8_t BufferTx[MAX_APP_BUFFER_SIZE];

/** Application RX buffer. */
static uint8_t BufferRx[MAX_APP_BUFFER_SIZE];


/** Number of bytes in the last received payload. */
static uint16_t RxBufferSize = 0;

/** RSSI of the last received packet [dBm]. */
static int16_t RssiValue = 0;

/** SNR of the last received LoRa packet [dB].  0 for FSK. */
static int8_t SnrValue = 0;

/* --- Statistics counters -------------------------------------------------- */
static uint32_t rxCounter      = 0; /**< Total packets received from Master. */
static uint32_t ackSentCounter = 0; /**< Total ACKs successfully transmitted.*/
static uint32_t errorCounter   = 0; /**< Total RX errors + TX timeouts.      */

/* --- Timer objects --------------------------------------------------------- */
static UTIL_TIMER_Object_t timerLed; /**< Heartbeat LED blink timer.         */

